<%- include('../partials/header', { title: title }) %>
<%- include('../partials/navbar') %>

<div class="app-layout">
  <%- include('../partials/sidebar') %>

  <div class="main-content-wrapper">
    <main class="page-content">
      <div class="page-header">
        <div>
          <h1 class="page-title"><i class="fa-solid fa-id-card"></i> Assign / Renew Membership Plan</h1>
          <p class="page-subtitle">Configure membership subscription for <strong><%= member.name %></strong></p>
        </div>
        <div class="page-header-actions">
          <a href="/admin/members" class="btn btn-secondary">
            <i class="fa-solid fa-arrow-left"></i> Back to Members
          </a>
        </div>
      </div>

      <%- include('../partials/flash') %>

      <div class="card form-card">
        <% if (currentMembership) { %>
          <div style="background: rgba(255, 255, 255, 0.03); border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 1.25rem; margin-bottom: 1.5rem;">
            <h3 style="font-size: 1rem; color: var(--accent-primary); margin-bottom: 0.5rem;">Current Membership Details</h3>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; font-size: 0.9rem;">
              <div><strong>Current Plan:</strong> <%= currentMembership.plan ? currentMembership.plan.name : 'Unknown' %></div>
              <div><strong>Status:</strong> <span class="badge badge-<%= currentMembership.status.toLowerCase() %>"><%= currentMembership.status %></span></div>
              <div><strong>Start Date:</strong> <%= new Date(currentMembership.startDate).toLocaleDateString() %></div>
              <div><strong>End Date:</strong> <%= new Date(currentMembership.endDate).toLocaleDateString() %></div>
            </div>
          </div>
        <% } %>

        <form action="/admin/members/assign-membership/<%= member._id %>" method="POST">
          <div class="form-group">
            <label for="planId" class="form-label">Select Membership Plan <span class="req">*</span></label>
            <select id="planId" name="planId" class="form-control" required>
              <option value="">-- Choose a Plan --</option>
              <% plans.forEach(p => { %>
                <option value="<%= p._id %>">
                  <%= p.name %> — <%= p.duration %> Days (₹<%= p.price %>)
                </option>
              <% }); %>
            </select>
          </div>

          <div class="form-group">
            <label for="customStartDate" class="form-label">Subscription Start Date</label>
            <input 
              type="date" 
              id="customStartDate" 
              name="customStartDate" 
              class="form-control" 
              value="<%= new Date().toISOString().split('T')[0] %>"
            >
            <small style="color: var(--text-muted); font-size: 0.8rem; margin-top: 0.25rem; display: block;">
              End date will be automatically calculated based on plan duration.
            </small>
          </div>

          <div class="form-actions">
            <a href="/admin/members" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary">
              <i class="fa-solid fa-check"></i> Assign Plan
            </button>
          </div>
        </form>
      </div>
    </main>
<%- include('../partials/footer') %>
