<%- include('../partials/header', { title: title }) %>
<%- include('../partials/navbar') %>

<div class="app-layout">
  <%- include('../partials/sidebar') %>

  <div class="main-content-wrapper">
    <main class="page-content">
      <div class="page-header">
        <div>
          <h1 class="page-title"><i class="fa-solid fa-chart-pie"></i> Admin Dashboard</h1>
          <p class="page-subtitle">Overview of gym memberships, attendance, and operations</p>
        </div>
        <div class="page-header-actions">
          <a href="/admin/members/add" class="btn btn-primary">
            <i class="fa-solid fa-user-plus"></i> Add Member
          </a>
          <a href="/admin/plans/add" class="btn btn-secondary">
            <i class="fa-solid fa-plus"></i> New Plan
          </a>
        </div>
      </div>

      <%- include('../partials/flash') %>

      <!-- Dynamic Stat Cards -->
      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-content">
            <span class="stat-label">Total Members</span>
            <span class="stat-value"><%= totalMembers %></span>
          </div>
          <div class="stat-icon">
            <i class="fa-solid fa-users"></i>
          </div>
        </div>

        <div class="stat-card card-success">
          <div class="stat-content">
            <span class="stat-label">Active Members</span>
            <span class="stat-value"><%= activeMembersCount %></span>
          </div>
          <div class="stat-icon">
            <i class="fa-solid fa-user-check"></i>
          </div>
        </div>

        <div class="stat-card card-warning">
          <div class="stat-content">
            <span class="stat-label">Expired Members</span>
            <span class="stat-value"><%= expiredMembersCount %></span>
          </div>
          <div class="stat-icon">
            <i class="fa-solid fa-user-xmark"></i>
          </div>
        </div>

        <div class="stat-card card-info">
          <div class="stat-content">
            <span class="stat-label">Today's Attendance</span>
            <span class="stat-value"><%= todayAttendanceCount %></span>
          </div>
          <div class="stat-icon">
            <i class="fa-solid fa-clipboard-user"></i>
          </div>
        </div>
      </div>

      <!-- Dashboard Grid: Expiring Memberships & Plan Distribution -->
      <div class="dashboard-grid">
        <!-- Expiring Soon Table -->
        <div class="card">
          <div class="card-header">
            <h2 class="card-title">
              <i class="fa-solid fa-clock-rotate-left" style="color: var(--accent-warning);"></i> 
              Expiring Soon (Next 7 Days)
            </h2>
            <a href="/admin/expiring-memberships" class="btn btn-sm btn-secondary">View All</a>
          </div>

          <% if (expiringMemberships && expiringMemberships.length > 0) { %>
            <div class="table-responsive">
              <table class="data-table">
                <thead>
                  <tr>
                    <th>Member</th>
                    <th>Plan</th>
                    <th>Expiry Date</th>
                    <th>Days Remaining</th>
                    <th>Status</th>
                    <th>Action</th>
                  </tr>
                </thead>
                <tbody>
                  <% expiringMemberships.forEach(item => { %>
                    <tr>
                      <td>
                        <strong><%= item.member ? item.member.name : 'Unknown' %></strong>
                        <div style="font-size: 0.8rem; color: var(--text-secondary);"><%= item.member ? item.member.email : '' %></div>
                      </td>
                      <td><%= item.plan ? item.plan.name : 'N/A' %></td>
                      <td>
                        <%= new Date(item.endDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                      </td>
                      <td>
                        <span style="font-weight: 700; color: <%= item.daysRemaining <= 3 ? '#ef4444' : '#f59e0b' %>">
                          <i class="fa-solid fa-hourglass-half"></i> <%= item.daysRemaining %> days
                        </span>
                      </td>
                      <td>
                        <span class="badge badge-expiring">Expiring Soon</span>
                      </td>
                      <td>
                        <a href="/admin/members/assign-membership/<%= item.member ? item.member._id : '' %>" class="btn btn-sm btn-primary" title="Renew Plan">
                          <i class="fa-solid fa-arrows-rotate"></i> Renew
                        </a>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <div class="empty-state">
              <i class="fa-solid fa-shield-heart empty-state-icon"></i>
              <h3 class="empty-state-title">No Memberships Expiring Soon</h3>
              <p class="empty-state-desc">All active members have more than 7 days remaining on their memberships.</p>
            </div>
          <% } %>
        </div>

        <!-- Plan-wise Distribution Chart & Stats -->
        <div class="card">
          <div class="card-header">
            <h2 class="card-title">
              <i class="fa-solid fa-chart-donut" style="color: var(--accent-info);"></i> 
              Plan Distribution
            </h2>
            <a href="/admin/plans" class="btn btn-sm btn-secondary">Plans</a>
          </div>

          <div style="position: relative; height: 220px; width: 100%; display: flex; align-items: center; justify-content: center;">
            <canvas id="planDistributionChart"></canvas>
          </div>

          <div style="margin-top: 1.5rem;">
            <% planStats.forEach(plan => { %>
              <div style="display: flex; justify-content: space-between; align-items: center; padding: 0.5rem 0; border-bottom: 1px solid var(--border-color); font-size: 0.9rem;">
                <span style="font-weight: 600;"><%= plan.name %></span>
                <span class="badge badge-active"><%= plan.count %> members</span>
              </div>
            <% }); %>
          </div>
        </div>
      </div>
    </main>

    <script>
      // Initialize Plan Distribution Chart
      const planStatsData = <%- JSON.stringify(planStats) %>;
      const ctx = document.getElementById('planDistributionChart');
      if (ctx && planStatsData.length > 0) {
        new Chart(ctx, {
          type: 'doughnut',
          data: {
            labels: planStatsData.map(p => p.name),
            datasets: [{
              data: planStatsData.map(p => p.count),
              backgroundColor: ['#ef4444', '#3b82f6', '#10b981', '#f59e0b', '#8b5cf6'],
              borderColor: '#111827',
              borderWidth: 2
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: {
                position: 'bottom',
                labels: {
                  color: '#94a3b8',
                  boxWidth: 12,
                  font: { family: 'Inter', size: 11 }
                }
              }
            },
            cutout: '65%'
          }
        });
      }
    </script>
<%- include('../partials/footer') %>
