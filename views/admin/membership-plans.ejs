<%- include('../partials/header', { title: title }) %>
<%- include('../partials/navbar') %>

<div class="app-layout">
  <%- include('../partials/sidebar') %>

  <div class="main-content-wrapper">
    <main class="page-content">
      <div class="page-header">
        <div>
          <h1 class="page-title"><i class="fa-solid fa-id-card"></i> Membership Plans</h1>
          <p class="page-subtitle">Configure subscription tiers, durations, and pricing</p>
        </div>
        <div class="page-header-actions">
          <a href="/admin/plans/add" class="btn btn-primary">
            <i class="fa-solid fa-plus"></i> Create New Plan
          </a>
        </div>
      </div>

      <%- include('../partials/flash') %>

      <div class="card" style="padding: 0; overflow: hidden;">
        <% if (plans && plans.length > 0) { %>
          <div class="table-responsive">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Plan Name</th>
                  <th>Duration</th>
                  <th>Price</th>
                  <th>Active Subscribers</th>
                  <th>Description</th>
                  <th style="text-align: right;">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% plans.forEach(p => { %>
                  <tr>
                    <td>
                      <strong style="font-size: 1rem;"><%= p.name %></strong>
                    </td>
                    <td>
                      <span class="badge badge-active">
                        <i class="fa-solid fa-calendar-days"></i> <%= p.duration %> Days
                      </span>
                    </td>
                    <td>
                      <strong style="color: var(--accent-secondary); font-size: 1.05rem;">
                        ₹<%= p.price.toLocaleString() %>
                      </strong>
                    </td>
                    <td>
                      <span class="badge badge-expiring"><%= p.activeMembers %> Members</span>
                    </td>
                    <td style="color: var(--text-secondary); max-width: 250px;">
                      <%= p.description || 'No description provided' %>
                    </td>
                    <td>
                      <div class="action-buttons" style="justify-content: flex-end;">
                        <a href="/admin/plans/edit/<%= p._id %>" class="btn btn-sm btn-secondary" title="Edit Plan">
                          <i class="fa-solid fa-pen"></i> Edit
                        </a>
                        <form action="/admin/plans/<%= p._id %>?_method=DELETE" method="POST" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this plan?');">
                          <button type="submit" class="btn btn-sm btn-danger" title="Delete Plan">
                            <i class="fa-solid fa-trash"></i> Delete
                          </button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="empty-state">
            <i class="fa-solid fa-folder-open empty-state-icon"></i>
            <h3 class="empty-state-title">No Membership Plans Created</h3>
            <p class="empty-state-desc">Set up membership options like Monthly, Quarterly, or Yearly plans.</p>
            <a href="/admin/plans/add" class="btn btn-primary">
              <i class="fa-solid fa-plus"></i> Create First Plan
            </a>
          </div>
        <% } %>
      </div>
    </main>
<%- include('../partials/footer') %>
