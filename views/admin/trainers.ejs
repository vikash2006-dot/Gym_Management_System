<%- include('../partials/header', { title: title }) %>
<%- include('../partials/navbar') %>

<div class="app-layout">
  <%- include('../partials/sidebar') %>

  <div class="main-content-wrapper">
    <main class="page-content">
      <div class="page-header">
        <div>
          <h1 class="page-title"><i class="fa-solid fa-user-ninja"></i> Trainer Management</h1>
          <p class="page-subtitle">View active trainers and their assigned client workload</p>
        </div>
        <div class="page-header-actions">
          <a href="/admin/trainers/add" class="btn btn-primary">
            <i class="fa-solid fa-user-plus"></i> Add New Trainer
          </a>
          <a href="/admin/assign-trainer" class="btn btn-secondary">
            <i class="fa-solid fa-user-check"></i> Assign to Member
          </a>
        </div>
      </div>

      <%- include('../partials/flash') %>

      <div class="card" style="padding: 0; overflow: hidden;">
        <% if (trainers && trainers.length > 0) { %>
          <div class="table-responsive">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Trainer Name</th>
                  <th>Email Address</th>
                  <th>Phone Number</th>
                  <th>Assigned Members</th>
                  <th>Joined Date</th>
                  <th style="text-align: right;">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% trainers.forEach(t => { %>
                  <tr>
                    <td>
                      <strong style="font-size: 1rem;"><%= t.name %></strong>
                    </td>
                    <td><%= t.email %></td>
                    <td><%= t.phone || '<span style="color:var(--text-muted);">N/A</span>' %></td>
                    <td>
                      <span class="badge badge-active" style="font-size: 0.85rem;">
                        <i class="fa-solid fa-users"></i> <%= t.assignedCount %> <%= t.assignedCount === 1 ? 'member' : 'members' %>
                      </span>
                    </td>
                    <td>
                      <%= new Date(t.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                    </td>
                    <td>
                      <div class="action-buttons" style="justify-content: flex-end;">
                        <a href="/admin/assign-trainer" class="btn btn-sm btn-secondary" title="Assign Clients">
                          <i class="fa-solid fa-user-plus"></i> Assign
                        </a>
                        <form action="/admin/trainers/<%= t._id %>?_method=DELETE" method="POST" style="display: inline;" onsubmit="return confirm('Are you sure you want to remove trainer <%= t.name %>? Their assigned members will become unassigned.');">
                          <button type="submit" class="btn btn-sm btn-danger" title="Remove Trainer">
                            <i class="fa-solid fa-trash"></i> Remove
                          </button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="empty-state">
            <i class="fa-solid fa-user-slash empty-state-icon"></i>
            <h3 class="empty-state-title">No Trainers Registered</h3>
            <p class="empty-state-desc">Create trainer accounts so members can be assigned fitness coaches.</p>
            <a href="/admin/trainers/add" class="btn btn-primary">
              <i class="fa-solid fa-user-plus"></i> Add First Trainer
            </a>
          </div>
        <% } %>
      </div>
    </main>
<%- include('../partials/footer') %>
