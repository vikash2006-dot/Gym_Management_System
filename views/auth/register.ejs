<%- include('../partials/header', { title: 'Register - TitanFit Gym Management' }) %>
<%- include('../partials/navbar') %>

<div class="auth-wrapper">
  <div class="auth-card">
    <div class="auth-header">
      <div class="auth-brand-icon" style="background: linear-gradient(135deg, #10b981, #047857); box-shadow: 0 0 20px rgba(16, 185, 129, 0.4);">
        <i class="fa-solid fa-user-plus"></i>
      </div>
      <h1 class="auth-title">Member Registration</h1>
      <p class="auth-subtitle">Join TitanFit and start achieving your fitness goals</p>
    </div>

    <%- include('../partials/flash') %>

    <form action="/register" method="POST">
      <div class="form-group">
        <label for="name" class="form-label">Full Name <span class="req">*</span></label>
        <input 
          type="text" 
          id="name" 
          name="name" 
          class="form-control" 
          placeholder="e.g. Vikash Kumar" 
          required
        >
      </div>

      <div class="form-group">
        <label for="email" class="form-label">Email Address <span class="req">*</span></label>
        <input 
          type="email" 
          id="email" 
          name="email" 
          class="form-control" 
          placeholder="name@example.com" 
          required
        >
      </div>

      <div class="form-group">
        <label for="phone" class="form-label">Phone Number</label>
        <input 
          type="tel" 
          id="phone" 
          name="phone" 
          class="form-control" 
          placeholder="+91 98765 43210"
        >
      </div>

      <div class="form-row">
        <div class="form-group">
          <label for="password" class="form-label">Password <span class="req">*</span></label>
          <input 
            type="password" 
            id="password" 
            name="password" 
            class="form-control" 
            placeholder="Min. 6 chars" 
            minlength="6"
            required
          >
        </div>

        <div class="form-group">
          <label for="confirmPassword" class="form-label">Confirm Password <span class="req">*</span></label>
          <input 
            type="password" 
            id="confirmPassword" 
            name="confirmPassword" 
            class="form-control" 
            placeholder="Re-type password" 
            minlength="6"
            required
          >
        </div>
      </div>

      <button type="submit" class="btn btn-primary btn-block" style="margin-top: 1.5rem; background: var(--accent-secondary);">
        <i class="fa-solid fa-id-card"></i> Register as Member
      </button>
    </form>

    <div class="auth-footer">
      <p>Already have an account? <a href="/login">Sign In here</a></p>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
