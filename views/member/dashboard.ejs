<%- include('../partials/header', { title: title }) %>
<%- include('../partials/navbar') %>

<div class="app-layout">
  <%- include('../partials/sidebar') %>

  <div class="main-content-wrapper">
    <main class="page-content">
      <div class="page-header">
        <div>
          <h1 class="page-title"><i class="fa-solid fa-house-user"></i> Welcome, <%= member.name %>!</h1>
          <p class="page-subtitle">Track your training sessions, membership status, and progress</p>
        </div>
        <div class="page-header-actions">
          <a href="/member/workout" class="btn btn-secondary">
            <i class="fa-solid fa-fire-flame-curved"></i> Full Workout Plan
          </a>
        </div>
      </div>

      <%- include('../partials/flash') %>

      <!-- Top Summary Cards -->
      <div class="stats-grid">
        <!-- Membership Card -->
        <div class="stat-card <%= membershipStatus === 'Active' ? 'card-success' : 'card-warning' %>">
          <div class="stat-content">
            <span class="stat-label">Membership Plan</span>
            <div style="font-family: var(--font-heading); font-size: 1.4rem; font-weight: 700; color: var(--text-primary); margin-top: 0.25rem;">
              <%= membership && membership.plan ? membership.plan.name : 'No Active Plan' %>
            </div>
            <div style="margin-top: 0.5rem; font-size: 0.85rem;">
              <% if (membershipStatus === 'Active') { %>
                <span class="badge badge-active"><i class="fa-solid fa-check"></i> Active</span>
                <span style="color: var(--text-secondary); margin-left: 0.5rem;">Expires <%= formattedExpiry %> (<%= daysRemaining %>d left)</span>
              <% } else if (membershipStatus === 'Expired') { %>
                <span class="badge badge-expired"><i class="fa-solid fa-triangle-exclamation"></i> Expired</span>
              <% } else { %>
                <span class="badge badge-no-plan">No Plan</span>
              <% } %>
            </div>
          </div>
          <div class="stat-icon">
            <i class="fa-solid fa-id-card"></i>
          </div>
        </div>

        <!-- Assigned Trainer Card -->
        <div class="stat-card card-info">
          <div class="stat-content">
            <span class="stat-label">Assigned Trainer</span>
            <div style="font-family: var(--font-heading); font-size: 1.4rem; font-weight: 700; color: var(--text-primary); margin-top: 0.25rem;">
              <%= member.trainer ? member.trainer.name : 'Not Assigned' %>
            </div>
            <div style="margin-top: 0.5rem; font-size: 0.85rem; color: var(--text-secondary);">
              <% if (member.trainer) { %>
                <i class="fa-solid fa-envelope"></i> <%= member.trainer.email %>
                <% if (member.trainer.phone) { %> &bull; <i class="fa-solid fa-phone"></i> <%= member.trainer.phone %><% } %>
              <% } else { %>
                <span>Ask admin to assign a personal trainer.</span>
              <% } %>
            </div>
          </div>
          <div class="stat-icon">
            <i class="fa-solid fa-user-ninja"></i>
          </div>
        </div>

        <!-- Today's Attendance Card -->
        <div class="stat-card <%= hasMarkedToday ? 'card-success' : '' %>">
          <div class="stat-content">
            <span class="stat-label">Today's Attendance</span>
            <div style="margin-top: 0.5rem;">
              <% if (hasMarkedToday) { %>
                <span class="badge badge-active" style="font-size: 0.95rem; padding: 0.4rem 0.85rem;">
                  <i class="fa-solid fa-circle-check"></i> Attendance Already Marked
                </span>
                <div style="font-size: 0.8rem; color: var(--text-muted); margin-top: 0.35rem;">Marked for today</div>
              <% } else { %>
                <form action="/member/attendance" method="POST" style="margin-top: 0.25rem;">
                  <button type="submit" class="btn btn-sm btn-primary">
                    <i class="fa-solid fa-fingerprint"></i> Mark Today's Attendance
                  </button>
                </form>
              <% } %>
            </div>
          </div>
          <div class="stat-icon">
            <i class="fa-solid fa-calendar-check"></i>
          </div>
        </div>

        <!-- Current Weight Card -->
        <div class="stat-card">
          <div class="stat-content">
            <span class="stat-label">Current Weight</span>
            <span class="stat-value">
              <%= latestWeight ? latestWeight + ' kg' : '--' %>
            </span>
            <div style="margin-top: 0.25rem;">
              <a href="/member/weight-log" style="font-size: 0.8rem; color: var(--accent-primary); font-weight: 600;">
                <i class="fa-solid fa-plus"></i> Log Body Weight &rarr;
              </a>
            </div>
          </div>
          <div class="stat-icon">
            <i class="fa-solid fa-weight-scale"></i>
          </div>
        </div>
      </div>

      <!-- Today's Workout Routine Card -->
      <div class="card">
        <div class="card-header">
          <h2 class="card-title">
            <i class="fa-solid fa-dumbbell"></i> 
            Today's Workout — <%= currentDay %>
          </h2>
          <a href="/member/workout" class="btn btn-sm btn-secondary">Weekly Schedule</a>
        </div>

        <% if (todayExercises && todayExercises.length > 0) { %>
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
            <% todayExercises.forEach(ex => { %>
              <div style="background: rgba(255,255,255,0.02); border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 1.25rem; display: flex; align-items: center; justify-content: space-between;">
                <div>
                  <div style="font-weight: 700; font-size: 1.05rem; color: var(--text-primary);"><%= ex.exercise %></div>
                  <div style="font-size: 0.8rem; color: var(--text-secondary); margin-top: 0.2rem;">Target: Repetitions & Form</div>
                </div>
                <div style="background: rgba(239, 68, 68, 0.15); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.3); border-radius: var(--radius-sm); padding: 0.35rem 0.75rem; font-weight: 700; font-size: 0.95rem;">
                  <%= ex.sets %> &times; <%= ex.reps %>
                </div>
              </div>
            <% }); %>
          </div>
        <% } else if (workoutPlan) { %>
          <div class="empty-state" style="padding: 2rem 1rem;">
            <i class="fa-solid fa-bed empty-state-icon" style="color: var(--accent-info);"></i>
            <h3 class="empty-state-title">Rest & Recovery Day!</h3>
            <p class="empty-state-desc">No workouts scheduled for <%= currentDay %>. Take time to stretch, hydrate, and recover.</p>
            <a href="/member/workout" class="btn btn-secondary btn-sm">View Full Weekly Split</a>
          </div>
        <% } else { %>
          <div class="empty-state" style="padding: 2rem 1rem;">
            <i class="fa-solid fa-clipboard-question empty-state-icon"></i>
            <h3 class="empty-state-title">No Workout Plan Assigned Yet</h3>
            <p class="empty-state-desc">Your personal trainer has not yet created a workout program for you. Please check back soon.</p>
          </div>
        <% } %>
      </div>
    </main>
<%- include('../partials/footer') %>
